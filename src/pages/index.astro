---
import Layout from '../components/Layout.astro';
import { phases, lanes, cmsOptions, hostOptions, webflowVsComposable, sources, surveyedAt } from '../data/stack';

const questions = [
  {
    name: 'prioridad',
    title: '¿Qué prioriza el cliente?',
    options: [
      { value: 'propiedad', label: 'Rendimiento, código propio y costo bajo', checked: true },
      { value: 'velocidad', label: 'Lanzar rápido y editar visualmente' },
    ],
  },
  {
    name: 'editores',
    title: '¿Quién edita el contenido?',
    options: [
      { value: 'pocos', label: '1 a 3 personas, cambios ocasionales', checked: true },
      { value: 'marketing', label: 'Un equipo de marketing que edita seguido' },
      { value: 'canales', label: 'Contenido que se reutiliza en otros canales' },
    ],
  },
  {
    name: 'idiomas',
    title: '¿Cuántos idiomas?',
    options: [
      { value: 'uno', label: 'Uno', checked: true },
      { value: 'varios', label: 'Dos o más' },
    ],
  },
  {
    name: 'hosting',
    title: '¿Hay preferencia de hosting?',
    options: [
      { value: 'libre', label: 'No', checked: true },
      { value: 'vercel', label: 'Ya usa Vercel o hay Next.js' },
    ],
  },
];
const cmsList = Object.values(cmsOptions);
const hostList = Object.values(hostOptions);
---
<Layout title="Project 84: del brief al sitio publicado" description="Flowmap del stack composable de Polonio: proceso, roles, comparación de CMS y hosting, y costos.">
  <main id="top">
    <!-- Hero + recomendador -->
    <section id="elegir" class="mx-auto max-w-7xl px-5 pt-14 pb-12 md:px-8 md:pt-20">
      <div class="grid gap-10 lg:grid-cols-[1fr_1.25fr] lg:gap-16">
        <div>
          <h1 class="text-4xl leading-[1.05] md:text-6xl">Del brief al sitio publicado</h1>
          <p class="mt-6 max-w-[52ch] text-lg leading-relaxed text-muted">
            Cómo elegimos el stack de cada cliente, quién hace qué en cada fase y cuánto cuesta por mes. Respondé las cuatro preguntas y el mapa marca el camino.
          </p>
          <div class="mt-10 rounded-3xl border border-line p-6" aria-live="polite">
            <p class="text-sm text-muted">Recomendación</p>
            <div class="mt-4 grid gap-4 sm:grid-cols-3">
              <div><p class="text-xs text-muted">Ruta</p><p id="r-route" class="font-display text-2xl">Composable</p></div>
              <div class="only-composable"><p class="text-xs text-muted">CMS</p><p id="r-cms" class="font-display text-2xl text-green-l">Keystatic</p></div>
              <div class="only-composable"><p class="text-xs text-muted">Hosting</p><p id="r-host" class="font-display text-2xl text-green-l">Cloudflare</p></div>
            </div>
            <p id="r-why" class="mt-5 text-[15px] leading-relaxed text-muted"></p>
            <p class="mt-5 text-[15px]"><span class="text-muted">Costo mensual estimado:</span> <span id="r-cost" class="font-medium">US$0</span></p>
          </div>
        </div>
        <form id="recommender" class="grid gap-7" aria-label="Recomendador de stack">
          {questions.map((q) => (
            <fieldset>
              <legend class="mb-3 font-display text-lg">{q.title}</legend>
              <div class={`grid gap-2 ${q.options.length === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2'}`}>
                {q.options.map((o) => (
                  <label class="choice relative text-[15px]">
                    <input type="radio" name={q.name} value={o.value} checked={o.checked} />
                    <span>{o.label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))}
        </form>
      </div>
    </section>

    <!-- Flowmap -->
    <section id="proceso" class="border-t border-line py-14">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2 class="text-3xl md:text-4xl">Seis fases, tres roles</h2>
            <p class="mt-3 max-w-[60ch] text-muted">El cliente aprueba en las compuertas punteadas. Tocá cualquier paso para ver el detalle.</p>
          </div>
          <p class="text-sm text-muted md:hidden">Deslizá para ver todas las fases.</p>
        </div>
      </div>
      <div class="mx-auto mt-10 max-w-7xl overflow-x-auto px-5 pb-4 md:px-8">
        <div class="relative">
          <div class="track" aria-hidden="true"></div>
          <div class="map" role="list">
            <div></div>
            {phases.map((p, i) => (
              <div class="cell !border-l-0 pb-6" role="listitem">
                <div class="phase-dot relative z-10 mt-[17px]"></div>
                <button class="mt-4 text-left" data-phase={p.id}>
                  <span class="text-sm text-muted">{i + 1}</span>
                  <span class="block font-display text-xl">{p.name}</span>
                  <span class="mt-1 block text-[13px] leading-snug text-muted">{p.summary}</span>
                </button>
              </div>
            ))}

            {lanes.map((lane) => (
              <>
                <div class="lane-label row-line">
                  <p class="font-medium">{lane.name}</p>
                  <p class="text-[13px] text-muted">{lane.role}</p>
                </div>
                {phases.map((p) => (
                  <div class="cell row-line flex flex-col gap-2">
                    <button class="node" data-phase={p.id}>{p.tasks[lane.id]}</button>
                    {lane.id === 'cliente' && p.gate && (
                      <button class="node gate" data-phase={p.id}>✓ {p.gate}</button>
                    )}
                  </div>
                ))}
              </>
            ))}

            <div class="lane-label row-line">
              <p class="font-medium">Herramientas</p>
              <p class="text-[13px] text-muted">Según la ruta</p>
            </div>
            {phases.map((p) => (
              <div class="cell row-line flex flex-col gap-2">
                {p.fork === 'cms' && (
                  <div class="only-composable-hide flex flex-col gap-2" role="radiogroup" aria-label="CMS">
                    {cmsList.map((c) => <button class="opt" data-cms={c.id}>{c.name}</button>)}
                  </div>
                )}
                {p.fork === 'host' && (
                  <div class="only-composable-hide flex flex-col gap-2" role="radiogroup" aria-label="Hosting">
                    {hostList.map((h) => <button class="opt" data-host={h.id}>{h.name}</button>)}
                  </div>
                )}
                <div class="only-composable-hide flex flex-wrap gap-1.5">
                  {p.tools.composable.map((t) => <span class="tool">{t}</span>)}
                </div>
                <div class="only-webflow flex flex-wrap gap-1.5">
                  {p.tools.webflow.map((t) => <span class="tool">{t}</span>)}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Comparar -->
    <section id="comparar" class="border-t border-line py-14">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <h2 class="text-3xl md:text-4xl">Comparar opciones</h2>
        <div class="mt-6 flex flex-wrap gap-2" role="tablist" aria-label="Comparaciones">
          <button class="tab" role="tab" aria-selected="true" aria-controls="t-cms" id="tab-cms">CMS</button>
          <button class="tab" role="tab" aria-selected="false" aria-controls="t-host" id="tab-host">Hosting</button>
          <button class="tab" role="tab" aria-selected="false" aria-controls="t-wf" id="tab-wf">Webflow o composable</button>
        </div>

        <div id="t-cms" role="tabpanel" aria-labelledby="tab-cms" class="mt-8 overflow-x-auto">
          <table class="tbl min-w-[760px]">
            <thead><tr><th></th>{cmsList.map((c) => <th data-col-cms={c.id}>{c.name}</th>)}</tr></thead>
            <tbody>
              <tr><td>Modelo</td>{cmsList.map((c) => <td data-col-cms={c.id}>{c.tagline}</td>)}</tr>
              <tr><td>Ideal para</td>{cmsList.map((c) => <td data-col-cms={c.id}>{c.idealFor}</td>)}</tr>
              <tr><td>A favor</td>{cmsList.map((c) => <td data-col-cms={c.id}>{c.pros.join('. ')}.</td>)}</tr>
              <tr><td>En contra</td>{cmsList.map((c) => <td data-col-cms={c.id}>{c.cons.join('. ')}.</td>)}</tr>
              <tr><td>Precio</td>{cmsList.map((c) => <td data-col-cms={c.id}>{c.price}</td>)}</tr>
            </tbody>
          </table>
        </div>

        <div id="t-host" role="tabpanel" aria-labelledby="tab-host" class="mt-8 overflow-x-auto" hidden>
          <table class="tbl min-w-[640px]">
            <thead><tr><th></th>{hostList.map((h) => <th data-col-host={h.id}>{h.name}</th>)}</tr></thead>
            <tbody>
              <tr><td>Cuándo</td>{hostList.map((h) => <td data-col-host={h.id}>{h.tagline}</td>)}</tr>
              <tr><td>A favor</td>{hostList.map((h) => <td data-col-host={h.id}>{h.pros.join('. ')}.</td>)}</tr>
              <tr><td>En contra</td>{hostList.map((h) => <td data-col-host={h.id}>{h.cons.join('. ')}.</td>)}</tr>
              <tr><td>Precio</td>{hostList.map((h) => <td data-col-host={h.id}>{h.price}</td>)}</tr>
            </tbody>
          </table>
        </div>

        <div id="t-wf" role="tabpanel" aria-labelledby="tab-wf" class="mt-8 overflow-x-auto" hidden>
          <table class="tbl min-w-[640px]">
            <thead><tr><th></th><th data-col-route="webflow">Webflow</th><th data-col-route="composable">Composable</th></tr></thead>
            <tbody>
              {webflowVsComposable.map((r) => (
                <tr><td>{r.label}</td><td data-col-route="webflow">{r.webflow}</td><td data-col-route="composable">{r.composable}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="mt-4 max-w-[80ch] text-sm text-muted">En el promedio de todos los sitios están empatados en Core Web Vitals; la diferencia aparece en los sitios con más tráfico. Fuente: HTTP Archive Technology Report, móvil, septiembre de 2026.</p>
        </div>
      </div>
    </section>

    <!-- Costos -->
    <section id="costos" class="border-t border-line py-14">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 md:px-8 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
        <div>
          <h2 class="text-3xl md:text-4xl">Costo mensual para el cliente</h2>
          <p class="mt-3 max-w-[52ch] text-muted">Se completa con la recomendación; podés ajustarlo a mano. Valores por sitio, en dólares, sin impuestos.</p>
          <form id="calc" class="mt-8 grid gap-6">
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="grid gap-2 text-sm text-muted">CMS
                <select name="cms">{cmsList.map((c) => <option value={c.id}>{c.name}</option>)}</select>
              </label>
              <label class="grid gap-2 text-sm text-muted">Hosting
                <select name="host">{hostList.map((h) => <option value={h.id}>{h.name}</option>)}</select>
              </label>
            </div>
            <label class="grid gap-2 text-sm text-muted">
              <span>Personas que editan: <output id="editors-out" class="font-medium text-ink">2</output></span>
              <input type="range" name="editors" min="1" max="25" value="2" />
            </label>
            <label class="flex items-start gap-3 text-[15px]">
              <input type="checkbox" name="editorRoles" class="mt-1 accent-green" />
              <span>Necesitan rol de editor sin permisos de administrador<span class="block text-sm text-muted">En Sanity esto requiere el plan Growth.</span></span>
            </label>
            <label class="flex items-start gap-3 text-[15px]">
              <input type="checkbox" name="serverFunctions" class="mt-1 accent-green" />
              <span>El sitio usa funciones de servidor<span class="block text-sm text-muted">Formularios propios, APIs o renderizado bajo demanda.</span></span>
            </label>
            <label class="grid gap-2 text-sm text-muted" id="seats-wrap" hidden>
              <span>Usuarios de desarrollo en Vercel: <output id="seats-out" class="font-medium text-ink">1</output></span>
              <input type="range" name="hostSeats" min="1" max="5" value="1" />
            </label>
          </form>
        </div>

        <div class="rounded-3xl bg-panel p-6 md:p-8" aria-live="polite">
          <p class="text-sm text-muted">Total estimado</p>
          <p id="c-total" class="mt-1 font-display text-6xl">US$0</p>
          <p class="mt-1 text-sm text-muted">por mes</p>
          <dl id="c-lines" class="mt-6 grid gap-3 border-t border-line pt-6 text-[15px]"></dl>
          <div class="mt-8 border-t border-line pt-6">
            <p class="text-sm text-muted">Mismo equipo editor, otras opciones</p>
            <div id="c-bars" class="mt-4 grid gap-4"></div>
          </div>
        </div>
      </div>
    </section>

    <footer class="border-t border-line py-10">
      <div class="mx-auto max-w-7xl px-5 text-sm text-muted md:px-8">
        <p>Precios relevados en {surveyedAt}. Cambian seguido: revalidar antes de cotizar.</p>
        <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
          {sources.map((s) => <li><a class="underline decoration-line underline-offset-4 hover:text-ink" href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
        </ul>
      </div>
    </footer>
  </main>

  <dialog id="drawer" class="drawer" aria-labelledby="d-title">
    <div class="flex h-full flex-col">
      <div class="flex items-start justify-between gap-4 border-b border-line p-6">
        <div>
          <p id="d-kicker" class="text-sm text-muted"></p>
          <h3 id="d-title" class="mt-1 text-2xl"></h3>
        </div>
        <button id="d-close" class="rounded-full border border-line px-3 py-1 text-sm hover:border-muted">Cerrar</button>
      </div>
      <div id="d-body" class="flex-1 overflow-y-auto p-6 text-[15px] leading-relaxed"></div>
    </div>
  </dialog>

  <script>
    import '../scripts/app';
  </script>
</Layout>
